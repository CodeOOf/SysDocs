# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Nix
result
result-*
.direnv/
.envrc

# Docker
.dockerignore

# Temporary files
*.tmp
*.temp
*.log
*.bak

# Application specific
appsettings.Development.json
appsettings.Local.json
secrets.json

# Code signing certificates and keys (NFR-07)
# NEVER commit production certificates to source control
*.pfx
*.p12
*.snk
*.key
keys/
certs/
certificates/
*.cer
*.crt
*.pem
# Allow example/template files if needed
!**/example.snk
!**/template.pfx

# Local development
local/
scratch/
tmp/
temp/
